PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/blogspace?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
ALLOW_IN_MEMORY_FALLBACK=false
# Number of trusted reverse-proxy hops (use 1 behind one trusted proxy; otherwise 0)
TRUST_PROXY_HOPS=0
